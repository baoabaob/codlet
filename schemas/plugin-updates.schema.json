{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codlet plugin update manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "plugins"],
  "properties": {
    "schema": {"const": 1},
    "kind": {"const": "codlet-plugin-updates"},
    "plugins": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {"$ref": "#/$defs/signedUpdate"}
    }
  },
  "$defs": {
    "publicKey": {"type": "string", "pattern": "^[A-Za-z0-9+/]{43}=$"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "manifestUrl", "publicKey"],
      "properties": {
        "schema": {"const": 1},
        "manifestUrl": {"type": "string", "format": "uri", "maxLength": 2048},
        "publicKey": {"$ref": "#/$defs/publicKey"}
      }
    },
    "signedUpdate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["payload", "publicKey", "signature"],
      "properties": {
        "payload": {"$ref": "#/$defs/payload"},
        "publicKey": {"$ref": "#/$defs/publicKey"},
        "signature": {"type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$"}
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "repositoryUrl", "tag", "asset"],
      "properties": {
        "id": {"type": "string", "maxLength": 128, "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)*$"},
        "version": {"type": "string", "maxLength": 64},
        "repositoryUrl": {"type": "string", "format": "uri", "maxLength": 2048},
        "tag": {"type": "string", "maxLength": 65},
        "asset": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "url", "bytes", "sha256"],
          "properties": {
            "name": {"type": "string", "maxLength": 255, "pattern": "\\.[zZ][iI][pP]$"},
            "url": {"type": "string", "format": "uri", "maxLength": 2048},
            "bytes": {"type": "integer", "minimum": 1, "maximum": 33554432},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        }
      }
    }
  }
}
