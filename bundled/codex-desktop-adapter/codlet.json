{
  "schema": 1,
  "id": "codex.desktop.adapter",
  "name": "Codex Desktop Adapter",
  "tags": ["Adapter"],
  "description": "Connect plugins to supported Codex desktop features.",
  "i18n": {
    "zh": { "name": "Codex 桌面适配器", "description": "为插件提供已适配的 Codex 桌面功能。" },
    "en": { "name": "Codex Desktop Adapter", "description": "Connect plugins to supported Codex desktop features." }
  },
  "version": "0.1.0",
  "renderer": { "entry": "renderer.js", "world": "main" },
  "permissions": ["ui.mainWorld"],
  "provides": [
    { "name": "codex.desktop.compatibility", "api": 1, "scope": "target" },
    { "name": "codex.ui.preSubmit", "api": 1, "scope": "target" },
    { "name": "codex.backend.read", "api": 1, "scope": "target" },
    { "name": "codex.backend.write", "api": 1, "scope": "target" },
    { "name": "codex.backend.events", "api": 1, "scope": "target" },
    { "name": "codex.backend.transport", "api": 1, "scope": "target" }
  ]
}
